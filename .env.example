# ── CareChain AI (server-side only: never prefix these with VITE_) ──────────
# Gemini: powers record embeddings and the doctor-facing patient overview.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=768

# ChromaDB vector index (a derived search index; the CareChain store stays the source of truth).
# Self-hosted / local:   CHROMA_URL=http://localhost:8000   (CHROMA_API_KEY only if your server requires a token)
# Chroma Cloud:          CHROMA_API_KEY=...  CHROMA_TENANT=...  CHROMA_DATABASE=...  (leave CHROMA_URL empty)
CHROMA_URL=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# CHROMA_COLLECTION=carechain_medical_records

# Optional: enables the operator-only POST /api/ai/reindex endpoint (header x-admin-token). Leave empty to disable it.
AI_ADMIN_TOKEN=

# Server auth + API (existing)
# JWT_SECRET=
# PORT=5000

# Not used by the current server (clinical data lives in server/data/store.json). Only needed if the data layer is
# moved to Supabase; the service-role key must never be exposed to the browser.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
